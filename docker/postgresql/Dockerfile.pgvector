ARG POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:18@sha256:74935e72241653ca55e0414067e6d8763aceb8a810eb51b452253ec3dcfc4336
FROM ${POSTGRES_IMAGE}

RUN apt-get update \
    && apt-get install --yes --no-install-recommends postgresql-${PG_MAJOR}-pgvector \
    && rm -rf /var/lib/apt/lists/*
