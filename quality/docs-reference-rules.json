{
  "schema": 1,
  "extra_targets": [
    "_project/design/api-public-symbols.json",
    "quality/docs-ownership.json",
    "scripts/check_docs_ownership.py",
    "scripts/check_public_contract_drift.py"
  ],
  "rules": [
    {
      "id": "oracle-exposure-exemptions",
      "match": [".github/oracle-reviewers.yml"],
      "disposition": "governance-stays",
      "reason": "Trusted oracle exposure policy matches documentation paths without reading site-owned page content or changing review scope."
    },
    {
      "id": "lock-tests-docs-directory",
      "match": [
        "tests/unit/docs/*.py"
      ],
      "disposition": "lock-test",
      "reason": "Lock tests that read site-owned pages; each is mapped in quality/doc-lock-tests.json."
    },
    {
      "id": "lock-tests-core",
      "match": [
        "tests/unit/core/test_benchmark_api_contract.py",
        "tests/unit/core/test_compute_resource_unification.py",
        "tests/unit/core/test_execution_vocabulary_parity.py",
        "tests/unit/core/test_platform_registry.py",
        "tests/unit/cli/test_shipped_docs_urls.py",
        "tests/unit/generators/test_sf1_measurement.py",
        "tests/unit/mcp/test_run_surface_contract.py",
        "tests/unit/platforms/credentials/test_singlestore_credentials.py",
        "tests/unit/scripts/test_soundness_paths.py",
        "tests/unit/test_cli_documentation.py",
        "tests/unit/test_release_infrastructure.py",
        "tests/unit/workflows/test_stacked_pr_base_guard.py",
        "tests/unit/core/tpcds_obt/test_tpcds_obt_model.py",
        "tests/system/test_ci_lint_parity.py"
      ],
      "disposition": "lock-test",
      "reason": "Lock tests that read or name site-owned pages; each is mapped in quality/doc-lock-tests.json."
    },
    {
      "id": "public-contract-guards",
      "match": [
        "scripts/check_public_contract_drift.py",
        ".github/workflows/ci.yml"
      ],
      "disposition": "contract-replaced",
      "contract_fields": [
        "/benchmarks/registry_summary",
        "/benchmarks/ids",
        "/benchmarks/loader_ids",
        "/platforms/count_summary",
        "/result_schema_version"
      ],
      "reason": "The CLI-inline and script registry-count guards keep hand-maintained counts out of retained core pages; the site checks these fields instead."
    },
    {
      "id": "contract-export-tooling",
      "match": [
        "scripts/doc_contracts.py",
        "scripts/docs_history_filter.py",
        "scripts/doc_reference_inventory.py",
        "tests/unit/scripts/test_doc_contracts.py",
        "tests/unit/scripts/test_docs_history_filter.py",
        "tests/unit/scripts/test_doc_reference_inventory.py"
      ],
      "disposition": "contract-tooling",
      "reason": "The exporter, its schema checks and the reference inventory itself; they read core-owned inputs and the ownership manifest."
    },
    {
      "id": "readme-version-substitution",
      "match": [
        "benchbox/utils/VERSION_MANAGEMENT.md",
        "benchbox/utils/version.py",
        "scripts/update_version.py",
        "tests/unit/scripts/test_release_flow.py",
        "tests/unit/test_version_management.py"
      ],
      "disposition": "governance-stays",
      "contract_fields": [
        "/package/release_marker",
        "/ownership/transitions"
      ],
      "reason": "docs/README.md keeps its release marker in core; version substitution stays core-owned and the marker selector is exported."
    },
    {
      "id": "site-input-pipeline",
      "match": [
        "scripts/check_docs_ownership.py",
        "scripts/site_inputs.py",
        "tests/unit/scripts/test_docs_ownership.py",
        "tests/unit/scripts/test_site_inputs.py"
      ],
      "disposition": "site-pipeline-cutover",
      "reason": "Verifies the core-owned docs tree and builds the docs members of the site bundle from retained sources and the ownership manifest."
    },
    {
      "id": "doc-link-and-example-checkers",
      "match": [
        "scripts/validate_example_references.py"
      ],
      "disposition": "governance-stays",
      "reason": "Validates file references in the retained docs tree against retained example files; relative and external link checking moved to site CI."
    },
    {
      "id": "publication-policy-readers",
      "match": [
        "_project/scripts/agent_instruction_audit.py",
        "tests/unit/scripts/test_agent_instruction_audit.py"
      ],
      "disposition": "governance-stays",
      "contract_fields": [
        "/publication"
      ],
      "reason": "Reads core-retained agent and publication policy pages; publish lists stay in core."
    },
    {
      "id": "comment-policy-registries",
      "match": [
        "quality/comment-cleanup-scope.json",
        "quality/comment-policy.json"
      ],
      "disposition": "wiring-updated",
      "reason": "Protected comment-policy registries name docs paths and generator scripts that move or are deleted at cutover; edited with oracle review."
    },
    {
      "id": "ci-path-classification",
      "match": [
        ".github/ci-units.yml",
        ".github/inert-paths.txt",
        ".github/soundness-paths.txt",
        ".github/path-filters.yml",
        ".pre-commit-config.yaml",
        "scripts/canary_impact.py",
        "scripts/ci_units.py",
        "scripts/comment_syntax.py",
        "scripts/path_filter_decision.py",
        "scripts/pr_landing.py",
        "scripts/pr_refresh_certification.py",
        "scripts/skill_sync_ci_policy.py",
        "tests/unit/scripts/test_canary_impact.py",
        "tests/unit/test_canary_impact.py",
        "tests/unit/scripts/test_ci_units.py",
        "tests/unit/scripts/test_inert_paths.py",
        "tests/unit/scripts/test_soundness_paths.py",
        "tests/unit/scripts/test_path_filter_decision.py"
      ],
      "disposition": "wiring-updated",
      "reason": "Path filters, inert-path and soundness-path rules (including the public-record exceptions) and CI unit selection treat docs/ as a path class; entries for moved pages change at cutover."
    },
    {
      "id": "agent-and-contributor-prose",
      "match": [
        ".claude/**",
        ".github/PULL_REQUEST_TEMPLATE.md",
        "AGENTS.md",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "README.md",
        "benchbox/core/cost/README.md",
        "benchbox/core/tuning/templates/README.md",
        "benchbox/core/write_primitives/README.md",
        "changelog.d/**",
        "docker/**",
        "examples/**/*.md",
        "results-data/*.md",
        "tests/README.md",
        "tests/uat/*.md",
        "tests/uat/configs/**"
      ],
      "disposition": "prose-link-pinned",
      "reason": "Prose in core-owned files that links to a site-owned page; relinked to the published URL or a pinned GitHub URL at cutover."
    },
    {
      "id": "build-and-ignore-wiring",
      "match": [
        ".gitignore",
        "Makefile",
        "make/**",
        "pyproject.toml",
        "_project/scripts/platform_scaffold.py",
        "scripts/new_platform_scaffold.py"
      ],
      "disposition": "wiring-updated",
      "reason": "Make targets, ignore rules and scaffolding that build, ignore or generate docs paths; updated when docs leave core."
    },
    {
      "id": "project-tooling",
      "match": [
        "_project/scripts/**"
      ],
      "disposition": "wiring-updated",
      "reason": "Tracked project tooling that names docs paths as inputs, outputs or sample data; reviewed at cutover."
    },
    {
      "id": "project-records",
      "match": [
        "_project/goal-shrink-core-code.md",
        "_project/_archive/**",
        "_project/analysis/**",
        "_project/archive/**",
        "_project/audits/**",
        "_project/blind-spots/**",
        "_project/decisions/**",
        "_project/handoffs/**",
        "_project/planning/**",
        "_project/release-evidence/**",
        "_project/shrink-ledger/**",
        "_project/specs/**",
        "_project/sql-translation-ml/**",
        "_project/todo-db-export/**"
      ],
      "aggregate": true,
      "disposition": "historical-record",
      "reason": "Audits, decisions, handoffs, archives and tracker exports that record docs paths; they execute nothing and are not rewritten."
    },
    {
      "id": "test-sample-data",
      "match": [
        "scripts/changelog_fragments.py",
        "scripts/check_untracked_handoffs.sh",
        "scripts/generate_changelog_entry.py",
        "scripts/release_cut_abort.sh",
        "scripts/worktree_lifecycle.sh",
        "tests/fixtures/fast_tier_baseline/tests-00.json",
        "tests/fixtures/fast_tier_baseline/tests-01.json",
        "tests/fixtures/fast_tier_baseline/tests-02.json",
        "tests/fixtures/fast_tier_baseline/tests-03.json",
        "tests/fixtures/fast_tier_baseline/tests-04.json",
        "tests/fixtures/fast_tier_baseline/tests-05.json",
        "tests/fixtures/fast_tier_baseline/tests-06.json",
        "tests/fixtures/fast_tier_baseline/tests-07.json",
        "tests/fixtures/medium_shard_durations.json",
        "tests/fixtures/oracle_reviewers/pr3222_replay.json",
        "tests/fixtures/ruleset-develop-squash-only.json",
        "tests/fixtures/trunk_red_20261024.json",
        "tests/integration/oracle/test_evidence_scenarios.py",
        "tests/integration/worktree/test_worktree_lifecycle_metadata.py",
        "tests/unit/release/test_ruleset_drift_review_coverage.py",
        "tests/unit/scripts/oracle_reviewers/test_classifier.py",
        "tests/unit/scripts/oracle_reviewers/test_cli_plan.py",
        "tests/unit/scripts/oracle_reviewers/test_evidence.py",
        "tests/unit/scripts/oracle_reviewers/test_local_review.py",
        "tests/unit/scripts/oracle_reviewers/test_render.py",
        "tests/unit/scripts/oracle_reviewers/test_runner.py",
        "tests/unit/scripts/oracle_reviewers/test_rounds.py",
        "tests/unit/scripts/oracle_reviewers/test_verdict.py",
        "tests/unit/scripts/test_blind_spot_tools.py",
        "tests/unit/scripts/test_changelog_fragments.py",
        "tests/unit/scripts/test_changelog_gate_cli.py",
        "tests/unit/scripts/test_check_untracked_handoffs.py",
        "tests/unit/scripts/test_ci_text_edit_verdict.py",
        "tests/unit/scripts/test_comment_cleanup_scope.py",
        "tests/unit/scripts/test_comment_policy.py",
        "tests/unit/scripts/test_coverage_test_selection.py",
        "tests/unit/scripts/test_dev_loop_pr_metrics.py",
        "tests/unit/scripts/test_oracle_gate.py",
        "tests/unit/scripts/test_oracle_review_check.py",
        "tests/unit/scripts/test_pr_landing.py",
        "tests/unit/scripts/test_pr_review_followups.py",
        "tests/unit/scripts/test_preflight_targets.py",
        "tests/unit/scripts/test_reference_usage_audit.py",
        "tests/unit/scripts/test_remote_closeout.py",
        "tests/unit/test_artifact_hygiene_guardrails.py",
        "tests/unit/test_ruleset_drift.py",
        "tests/unit/workflows/test_ci_aggregate_cancelled.py",
        "tests/unit/workflows/test_ci_text_edit_skip.py"
      ],
      "disposition": "fixture-data",
      "reason": "Docs-shaped strings used as sample paths, branch names or fixture data; no site-owned content is read."
    }
  ]
}
