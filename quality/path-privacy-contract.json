  "drive_letter": {
    "double_slash_excluded_for_forward": true,
    "separators": [
      "\\",
      "/"
    ]
  },
  "home_root": {
    "ancestors_of_home_are_not_data_roots": true,
    "scanned_as_root": true,
    "synthetic_home": "/srv/example-home"
  },
  "known_roots": [
    "/Users",
    "/Volumes",
    "/home",
    "/mnt",
    "/opt",
    "/private",
    "/root",
    "/tmp",
    "/var/folders",
    "/var/run",
    "~"
  ],
  "pattern": {
    "flags": 34,
    "source": "(?<![A-Za-z0-9_])(?:(?:~|/Users|/home|/root|/private|/var/folders|/var/run|/Volumes|/tmp|/mnt|/opt)/[^\\s'\\\",;)]*|[A-Za-z]:\\\\[^\\s'\\\",;)]*|[A-Za-z]:/(?!/)[^\\s'\\\",;)]*)|(?<![A-Za-z0-9_\\\\])\\\\{2,}[A-Za-z0-9_.$-]+\\\\+[^\\s'\\\",;)]*|(?<![A-Za-z0-9_:/\\\\])//[A-Za-z0-9_.$-]+/[A-Za-z0-9_.$-]+[^\\s'\\\",;)]*"
  },
  "placeholder_allowlist": [
    "/data",
    "/output"
  ],
  "redacted_placeholder": "<redacted>",
  "schema_version": 1,
  "unc": {
    "prefixes": [
      "\\\\",
      "//"
    ]
  }
