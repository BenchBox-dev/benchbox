{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"$(git rev-parse --show-toplevel)/scripts/primary_clone_write_guard.py\"; [ -f \"$p\" ] || exit 0; exec python3 \"$p\""
          }
        ]
      }
    ]
  }
}
