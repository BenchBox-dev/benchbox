  "cases": [
    {
      "id": "postgres-extract-fractional-division",
      "sql": "SELECT EXTRACT(YEAR FROM DATE '2020-06-01') / 3 > 673",
      "source": "postgres", "target": "sqlite", "identify": true, "call_shape": "transpile",
      "expected": {"outcome": "pass", "rows": [[1]]},
      "workaround": {"decision": "fork-covered", "path": "benchbox/utils/dialect_utils.py", "reason": "The carried PostgreSQL return-type and typed-DATE SQLite extraction patches preserve fractional division. Mixed legacy extraction handling remains for unproved input types."}
    },
    {
      "id": "postgres-integer-division",
      "sql": "SELECT 2020 / 3 > 673",
      "source": "postgres", "target": "sqlite", "identify": true, "call_shape": "transpile",
      "expected": {"outcome": "pass", "rows": [[0]]},
      "workaround": {"decision": "fork-covered", "path": "benchbox/utils/dialect_utils.py", "reason": "Fractional EXTRACT lowering must not promote ordinary PostgreSQL integer division."}
    },
    {
      "id": "sqlite-leap-day-interval",
      "sql": "SELECT DATE '2024-02-29' + INTERVAL '1' DAY",
      "source": "postgres", "target": "sqlite", "identify": true, "call_shape": "transpile",
      "expected": {"outcome": "pass", "rows": [["2024-03-01 00:00:00"]]},
      "workaround": {"decision": "fork-covered", "path": "benchbox/utils/dialect_utils.py", "reason": "The fork handles whole DAY/HOUR/MINUTE/SECOND intervals on typed DATE; the mixed helper still covers month/year syntax and DATE_TRUNC."}
    },
    {
      "id": "sqlite-null-interval",
      "sql": "SELECT CAST(NULL AS DATE) + INTERVAL '1' DAY",
      "source": "postgres", "target": "sqlite", "identify": true, "call_shape": "transpile",
      "expected": {"outcome": "pass", "rows": [[null]]},
      "workaround": {"decision": "fork-covered", "path": "benchbox/utils/dialect_utils.py", "reason": "Typed DATE interval lowering must preserve SQL NULL propagation."}
    },
    {
      "id": "sqlite-unknown-extract",
      "sql": "SELECT EXTRACT(YEAR FROM d) FROM t",
      "source": "postgres", "target": "sqlite", "identify": true, "call_shape": "transpile",
      "expected": {"outcome": "unsupported", "error_type": "UnsupportedError"},
      "workaround": {"decision": "retain", "path": "benchbox/utils/dialect_utils.py", "reason": "Unknown-input and timestamp extraction are outside the bounded source-type proof; retain the mixed BenchBox compatibility helper."}
    },
    {
      "id": "sqlite-month-interval",
      "sql": "SELECT DATE '2024-01-31' + INTERVAL '1' MONTH",
      "source": "postgres", "target": "sqlite", "identify": true, "call_shape": "transpile",
      "expected": {"outcome": "unsupported", "error_type": "UnsupportedError"},
      "workaround": {"decision": "retain", "path": "benchbox/utils/dialect_utils.py", "reason": "Month/year rollover semantics are not proved by the carried date arithmetic patch; do not retire mixed helper coverage."}
    },
    {
      "id": "questdb-dialect",
      "sql": "SELECT 1",
      "source": "postgres", "target": "questdb", "identify": true, "call_shape": "transpile",
      "expected": {"outcome": "unsupported", "error_type": "ValueError"},
      "workaround": {"decision": "retain", "path": "benchbox/platforms/questdb_rewriter.py", "reason": "QuestDB remains a BenchBox-owned compatibility path, not an admitted new fork capability."}
    },
    {
      "id": "duckdb-group-by-all",
      "sql": "WITH t AS (SELECT 1 AS x) SELECT x FROM t GROUP BY ALL",
      "source": "postgres", "target": "duckdb", "identify": true, "call_shape": "transpile",
      "expected": {"outcome": "pass", "rows": [[1]]},
      "workaround": {"decision": "retain", "path": "benchbox/utils/dialect_utils.py", "reason": "Acknowledged GROUP BY ALL success does not retire the shared helper: the matching ORDER BY ALL cross-dialect case still fails."}
    },
    {
      "id": "duckdb-order-by-all",
      "sql": "WITH t AS (SELECT 1 AS x) SELECT x FROM t ORDER BY ALL",
      "source": "postgres", "target": "duckdb", "identify": true, "call_shape": "transpile",
      "expected": {"outcome": "unsupported", "error_type": "BinderException"},
      "workaround": {"decision": "retain", "path": "benchbox/utils/dialect_utils.py", "reason": "PostgreSQL-normalized identifier quoting still produces an invalid DuckDB ALL-column reference; the restoration helper remains load-bearing."}
    },
    {
      "id": "mysql-percentile-decorator",
      "sql": "SELECT PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY x) FROM t",
      "source": "postgres", "target": "mysql", "identify": true, "call_shape": "transpile",
      "expected": {"outcome": "unsupported", "error_type": "SyntheticPercentileDecorator"},
      "workaround": {"decision": "retain", "path": "benchbox/core/tpchavoc/dialect_compat.py", "reason": "The MySQL-target percentile proxy still generates CASE/NULL decoration. Upstreamed SingleStore support does not prove this separate variant removable or certify native MySQL execution."}
    }
  ]
