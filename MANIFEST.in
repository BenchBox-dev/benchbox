include README.md
include CHANGELOG.md
include LICENSE
include pyproject.toml
include MANIFEST.in

recursive-include benchbox *.py *.sql *.yaml *.json *.jinja2 *.md *.csv *.toml
include benchbox/_vendor/*.zip
include benchbox/_vendor/SQLGLOT_LICENSE.txt

include _sources/README.md
include _sources/tpc-h/EULA.txt
include _sources/tpc-h/PATCHES.md
include _sources/tpc-h/stdout-support.patch
include _sources/tpc-ds/EULA.txt
include _sources/tpc-ds/PATCHES.md
include _sources/tpc-ds/stdout-support.patch
recursive-include _sources/compilation *
recursive-include _sources/tpc-ds/query_templates *.tpl *.lst
recursive-include _sources/tpc-ds/query_variants *.tpl
recursive-include _sources/tpc-h/dbgen/queries *.sql
recursive-include _sources/tpc-h/dbgen/variants *.sql

recursive-include benchbox/_binaries/tpc-h *
recursive-include benchbox/_binaries/tpc-ds *
include benchbox/_binaries/SHA256MANIFEST.json
global-exclude .DS_Store

prune tests
prune docs
prune examples

prune _project
prune .claude
prune .codex
prune .gemini
prune .github
prune .mypy_cache
prune .ruff_cache
prune htmlcov
prune landing
prune scripts
exclude .pre-commit-config.yaml
exclude .coveragerc_core
exclude .dockerignore
exclude .env.example
exclude .mcp.json
exclude AGENTS.md
exclude CLAUDE.md
exclude GEMINI.md
exclude todo.config.yaml
exclude skill-sync.yaml
exclude skill-sync.lock
exclude _benchbox_pytest_xdist_safety.py
exclude pytest.ini
exclude pytest-ci.ini
exclude Makefile

global-exclude *.py[cod] __pycache__ *.so *.dylib *.dll *.log
prune deploy
