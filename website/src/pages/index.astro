---
import CodeBlock from "../components/CodeBlock.astro";
import Logo from "../components/Logo.astro";
import CatalogGroup from "../components/landing/CatalogGroup.astro";
import Shell from "../layouts/Shell.astro";
import { benchmarkGroups, formatGroups, platformGroups } from "../lib/landing-data.ts";
import "../styles/landing.css";

const heroCode = String.raw`# CLI - Quick benchmarking
benchbox run --platform duckdb --benchmark tpch

# MCP - AI assistant integration
"Run TPC-H on DuckDB" # Claude executes via MCP

# Library - Deep Python integration
from benchbox import TPCH`;
const mcpSetupCode = String.raw`claude mcp add benchbox -- uv run python -m benchbox.mcp`;
const installCode = String.raw`uv add benchbox`;
const cliExampleCode = String.raw`# Quick TPC-H benchmark on DuckDB
benchbox run --platform duckdb --benchmark tpch --scale 0.1

# Preview on cloud before spending credits
benchbox run --platform databricks --benchmark tpch --dry-run ./preview`;
const libraryExampleCode = String.raw`from benchbox import TPCH

# Initialize and generate benchmark data
tpch = TPCH(scale_factor=0.1)
data_files = tpch.generate_data()

# Get schema and queries
create_sql = tpch.get_create_tables_sql()
query = tpch.get_query(1)  # Q1: Pricing Summary Report`;
const formatCode = String.raw`# Convert TPC-H data to different formats
benchbox convert --input ./tpch_sf1 --format parquet
benchbox convert --input ./tpch_sf1 --format delta
benchbox convert --input ./tpch_sf1 --format iceberg
benchbox convert --input ./tpch_sf1 --format ducklake`;
const tickerItems = benchmarkGroups.flatMap((group) => group.cards.map((card) => card.title));
const features = [
  {
    href: "/docs/usage/installation.html",
    title: "Python-Only Core",
    body: "Minimal requirements. A Python-only core with optional extras for cloud platforms. Install and go.",
  },
  {
    href: "/docs/benchmarks/index.html",
    title: "22 Benchmarks",
    body: "TPC standards, academic, industry, real-world, time-series, SQL primitives, AI/ML, and experimental workloads.",
  },
  {
    href: "/docs/platforms/dataframe.html",
    title: "SQL & DataFrame",
    body: "SQL databases (DuckDB, ClickHouse, cloud platforms) and DataFrame libraries (Polars, Pandas).",
  },
  {
    href: "/docs/usage/dialect-translation.html",
    title: "One Benchmark, Run Anywhere",
    body: "Automatic SQL translation. The same benchmark queries run on local and cloud databases.",
  },
  {
    href: "/docs/usage/data-generation.html",
    title: "Generate Data at Any Scale",
    body: "From 10 MB to 100 TB. No need to download pre-generated files.",
  },
  {
    href: "#mcp",
    title: "AI-Powered with MCP",
    body: "An MCP server for Claude Code and other AI assistants. Run benchmarks with natural language.",
  },
];
const mcpUses = [
  {
    title: "Discover",
    examples: ["What benchmarks are available?", "Which platforms support TPC-DS?"],
    body: "Explore 22 benchmarks and 50 platforms without reading documentation.",
  },
  {
    title: "Execute",
    examples: ["Run TPC-H on DuckDB at scale 0.1", "Compare Polars and Pandas on SSB"],
    body: "Run benchmarks without memorizing CLI syntax or options.",
  },
  {
    title: "Analyze",
    examples: ["Which queries were slowest?", "Compare results from my last two runs"],
    body: "Get AI-powered analysis of performance patterns and regressions.",
  },
];
const sectionLinks = [
  { href: "#overview", label: "Overview", key: "overview" },
  { href: "#results-explorer", label: "Public Results", key: "results" },
  { href: "#benchmarks", label: "Benchmarks", key: "benchmarks" },
  { href: "#platforms", label: "Platforms", key: "platforms" },
  { href: "#formats", label: "Table Formats", key: "formats" },
  { href: "#mcp", label: "AI Agents", key: "agents" },
  { href: "#install", label: "Get Started", key: "install" },
];
---

<Shell
  title="BenchBox - Run Your Own Benchmarks"
  description="Run your own benchmarks and compare database performance. 22 benchmarks (TPC-H/DS/DI, ClickBench, SSB, AI/ML, more). 50 platforms (DuckDB, Snowflake, Databricks, Polars, Onehouse, StarRocks, Doris, more). CLI, Python library, or MCP for AI assistants."
>
  <div class="landing">
    <section class="ticker" aria-label="Benchmarks BenchBox runs">
      <div class="ticker__track">
        <ul class="ticker__list">{tickerItems.map((item) => <li>{item}</li>)}</ul>
        <ul class="ticker__list" aria-hidden="true" inert>{tickerItems.map((item) => <li>{item}</li>)}</ul>
      </div>
    </section>

    <section id="overview" class="hero">
      <div class="container hero__inner">
        <Logo class="hero__logo" label="BenchBox" />
        <div class="hero__meta">
          <span>Open-source OLAP benchmarking</span>
          <span>CLI · Python library · MCP</span>
        </div>
        <div class="hero__layout">
          <div class="hero__copy">
            <h1 class="hero__title">Run Your Own Benchmarks</h1>
            <p class="hero__subtitle">
              Everyone says you should. BenchBox makes it easy to do. Use as CLI, Python library, or MCP for AI
              assistants. No Docker. No compilers. Just pip install.
            </p>
            <div class="hero__actions">
              <a class="button" href="/docs/usage/getting-started.html">Get started</a>
              <a class="button button--secondary" href="https://github.com/BenchBox-dev/benchbox" target="_blank" rel="noopener">
                Star on GitHub
              </a>
            </div>
            <div class="pills">
              <a class="soft-pill" href="https://github.com/BenchBox-dev/benchbox/releases" target="_blank" rel="noopener">v0.4.2</a>
              <a class="soft-pill" href="/docs/usage/installation.html">Python 3.11+</a>
              <a class="soft-pill" href="/docs/usage/installation.html#no-docker-required">No Docker Required</a>
            </div>
          </div>
          <div class="code-block">
            <div class="code-header">
              <span>CLI, Library, or MCP</span>
              <button class="copy-btn" type="button" data-target="hero-code">Copy</button>
            </div>
            <CodeBlock id="hero-code" lang="bash" code={heroCode} />
          </div>
        </div>
      </div>
    </section>

    <nav class="section-nav" aria-label="On this page">
      <div class="container section-nav__links">
        {
          sectionLinks.map((link) => (
            <a
              class={`section-nav__link section-nav__link--${link.key}`}
              href={link.href}
              aria-current={link.key === "overview" ? "location" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </nav>

    <section id="features" class="section">
      <div class="container">
        <header class="section__head">
          <p class="eyebrow">Why BenchBox</p>
          <h2>What Makes It Simple</h2>
        </header>
        <ol class="features">
          {
            features.map((feature, index) => (
              <li>
                <a class="feature" href={feature.href}>
                  <span class="feature__index">{String(index + 1).padStart(2, "0")}</span>
                  <h3>{feature.title}</h3>
                  <p>{feature.body}</p>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="results-explorer" class="section section--band results-explorer">
      <div class="container">
        <header class="section__head section__head--split">
          <div>
            <p class="eyebrow">From measurements to answers</p>
            <h2>Explore and Compare Benchmark Results</h2>
          </div>
          <div class="section__intro">
            <p>
              The Results Explorer turns BenchBox output into a browsable view of performance. Use the public corpus
              to understand how platforms behave on the same workload, or open your own result file in the browser
              before you share it.
            </p>
            <a class="button" href="/results/">Open the Results Explorer</a>
          </div>
        </header>
        <div class="results-explorer__showcase" role="group" aria-label="TPC-H on DuckDB scale factor 10 example">
            <article class="results-example-card results-example-card--summary">
                <div class="results-example-card__header">
                    <div>
                        <p class="results-example-card__label">TPC-H · Scale factor 10</p>
                        <h3>Four DuckDB versions, one comparable cohort</h3>
                    </div>
                    <a href="/results/compare?ids=6235bd1a,47bdcef5,282a4d75,19b96c85"
                        >View comparison →</a>
                </div>
                <dl class="results-example-stats">
                    <div><dt>Platforms</dt><dd>4</dd></div>
                    <div><dt>Queries</dt><dd>22</dd></div>
                    <div><dt>Best power</dt><dd>281,041</dd></div>
                    <div><dt>Phase</dt><dd>Power</dd></div>
                </dl>
                <div class="results-example-table-wrap" role="region" aria-label="DuckDB version comparison" tabindex="0">
                    <table class="results-example-table">
                        <thead>
                            <tr><th>Version</th><th>Geomean</th><th>Power@Size</th></tr>
                        </thead>
                        <tbody>
                            <tr class="results-series results-series--blue">
                                <th title="DuckDB v2.0.0-alpha38615"><span></span>DuckDB v2.0.0…</th><td>128 ms</td>
                                <td><i style="--bar-size: 100%"></i><b>281,041</b></td>
                            </tr>
                            <tr class="results-series results-series--green">
                                <th><span></span>DuckDB v1.5.5</th><td>152 ms</td>
                                <td><i style="--bar-size: 84%"></i><b>236,191</b></td>
                            </tr>
                            <tr class="results-series results-series--orange">
                                <th><span></span>DuckDB v1.4.4</th><td>168 ms</td>
                                <td><i style="--bar-size: 76%"></i><b>213,021</b></td>
                            </tr>
                            <tr class="results-series results-series--purple">
                                <th><span></span>DuckDB v1.3.2</th><td>189 ms</td>
                                <td><i style="--bar-size: 71%"></i><b>198,175</b></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </article>

            <figure class="results-example-card results-example-card--chart">
                <figcaption>
                    <span><strong>Latency distribution</strong>Range and middle 50% for all 22 queries</span>
                    <a href="/results/compare?ids=6235bd1a,47bdcef5,282a4d75,19b96c85&chart=distribution_box"
                        aria-label="Explore the full latency distribution comparison"
                        >Explore →</a>
                </figcaption>
                <svg viewBox="0 0 640 195" role="img" aria-label="Box plots of query latency for DuckDB v2.0.0-alpha38615, v1.5.5, v1.4.4 and v1.3.2">
                    <g class="results-chart-grid">
                        <line x1="181.5" y1="12" x2="181.5" y2="158"></line>
                        <line x1="254.3" y1="12" x2="254.3" y2="158"></line>
                        <line x1="337" y1="12" x2="337" y2="158"></line>
                        <line x1="395.8" y1="12" x2="395.8" y2="158"></line>
                        <line x1="478.5" y1="12" x2="478.5" y2="158"></line>
                        <line x1="582.8" y1="12" x2="582.8" y2="158"></line>
                    </g>
                    <g class="results-chart-labels">
                        <text x="8" y="37">v2.0.0…<title>DuckDB v2.0.0-alpha38615</title></text><text x="8" y="73">v1.5.5</text>
                        <text x="8" y="109">v1.4.4</text><text x="8" y="145">v1.3.2</text>
                    </g>
                    <g class="results-boxplot results-series--blue">
                        <line x1="178.2" y1="32" x2="542.5" y2="32"></line><line x1="178.2" y1="26" x2="178.2" y2="38"></line><line x1="542.5" y1="26" x2="542.5" y2="38"></line><rect x="257" y="22" width="72.1" height="20"></rect><line class="results-boxplot__median" x1="276.4" y1="22" x2="276.4" y2="42"></line>
                    </g>
                    <g class="results-boxplot results-series--green">
                        <line x1="178.8" y1="68" x2="531.3" y2="68"></line><line x1="178.8" y1="62" x2="178.8" y2="74"></line><line x1="531.3" y1="62" x2="531.3" y2="74"></line><rect x="284" y="58" width="105.7" height="20"></rect><line class="results-boxplot__median" x1="305.5" y1="58" x2="305.5" y2="78"></line>
                    </g>
                    <g class="results-boxplot results-series--orange">
                        <line x1="199.3" y1="104" x2="548.7" y2="104"></line><line x1="199.3" y1="98" x2="199.3" y2="110"></line><line x1="548.7" y1="98" x2="548.7" y2="110"></line><rect x="295.4" y="94" width="121.5" height="20"></rect><line class="results-boxplot__median" x1="337.6" y1="94" x2="337.6" y2="114"></line>
                    </g>
                    <g class="results-boxplot results-series--purple">
                        <line x1="218.2" y1="140" x2="600.6" y2="140"></line><line x1="218.2" y1="134" x2="218.2" y2="146"></line><line x1="600.6" y1="134" x2="600.6" y2="146"></line><rect x="315" y="130" width="131.4" height="20"></rect><line class="results-boxplot__median" x1="359" y1="130" x2="359" y2="150"></line>
                    </g>
                    <g class="results-chart-axis">
                        <line x1="150" y1="158" x2="620" y2="158"></line>
                        <text x="181.5" y="174">70</text><text x="254.3" y="174">100</text>
                        <text x="337" y="174">150</text><text x="395.8" y="174">200</text>
                        <text x="478.5" y="174">300</text><text x="582.8" y="174">500 ms</text>
                        <text class="results-chart-axis__title" x="385" y="191">Latency (log scale)</text>
                    </g>
                </svg>
            </figure>

            <figure class="results-example-card results-example-card--chart">
                <figcaption>
                    <span><strong>Cumulative latency</strong>Share of queries completed by each latency</span>
                    <a href="/results/compare?ids=6235bd1a,47bdcef5,282a4d75,19b96c85&chart=cdf_chart"
                        aria-label="Explore the full cumulative latency comparison"
                        >Explore →</a>
                </figcaption>
                <svg viewBox="0 0 640 230" role="img" aria-label="Cumulative query latency for DuckDB v2.0.0-alpha38615, v1.5.5, v1.4.4 and v1.3.2">
                    <g class="results-chart-grid">
                        <line x1="50" y1="190" x2="620" y2="190"></line><line x1="50" y1="147.5" x2="620" y2="147.5"></line><line x1="50" y1="105" x2="620" y2="105"></line><line x1="50" y1="62.5" x2="620" y2="62.5"></line><line x1="50" y1="20" x2="620" y2="20"></line>
                    </g>
                    <g class="results-chart-labels results-chart-labels--cdf">
                        <text x="42" y="194">0%</text><text x="42" y="151.5">25%</text>
                        <text x="42" y="109">50%</text><text x="42" y="66.5">75%</text>
                        <text x="42" y="24">100%</text>
                    </g>
                    <path class="results-cdf results-series--blue" d="M84.2,182.3 H96.5 V174.5 H105.6 V166.8 H157.7 V159.1 H161.4 V151.4 H177.2 V143.6 H187.1 V135.9 H191.3 V128.2 H197.3 V120.5 H202.5 V112.7 H203 V105 H203.6 V97.3 H205.6 V89.5 H207.4 V81.8 H211.7 V74.1 H237 V66.4 H276.5 V58.6 H336.4 V50.9 H341.5 V43.2 H433.6 V35.5 H476.5 V27.7 H526 V20"></path>
                    <path class="results-cdf results-series--green" d="M85,182.3 H121.5 V174.5 H143.1 V166.8 H201.4 V159.1 H206.3 V151.4 H207.8 V143.6 H226.3 V135.9 H229.7 V128.2 H231.7 V120.5 H235.8 V112.7 H237 V105 H240.3 V97.3 H247.4 V89.5 H263.3 V81.8 H268.6 V74.1 H310.7 V66.4 H349.9 V58.6 H445.9 V50.9 H451.8 V43.2 H464.3 V35.5 H478.4 V27.7 H512.4 V20"></path>
                    <path class="results-cdf results-series--orange" d="M109.8,182.3 H129.4 V174.5 H137.1 V166.8 H214.3 V159.1 H214.5 V151.4 H222.2 V143.6 H238.3 V135.9 H270.3 V128.2 H270.5 V120.5 H274 V112.7 H274.7 V105 H280.3 V97.3 H285.3 V89.5 H286.7 V81.8 H315.6 V74.1 H330.3 V66.4 H386.6 V58.6 H438.8 V50.9 H450.3 V43.2 H505.6 V35.5 H526.9 V27.7 H533.6 V20"></path>
                    <path class="results-cdf results-series--purple" d="M132.7,182.3 H150.6 V174.5 H168.1 V166.8 H219.5 V159.1 H236.6 V151.4 H245.4 V143.6 H263.6 V135.9 H265.2 V128.2 H268.6 V120.5 H296.5 V112.7 H301.2 V105 H305.8 V97.3 H310.7 V89.5 H313 V81.8 H366.4 V74.1 H367.2 V66.4 H422.1 V58.6 H489.7 V50.9 H498.4 V43.2 H568.9 V35.5 H575.9 V27.7 H596.4 V20"></path>
                    <g class="results-chart-axis">
                        <line x1="50" y1="190" x2="620" y2="190"></line>
                        <text x="88.2" y="207">70</text><text x="176.5" y="207">100</text>
                        <text x="276.8" y="207">150</text><text x="348" y="207">200</text>
                        <text x="448.4" y="207">300</text><text x="574.9" y="207">500 ms</text>
                        <text class="results-chart-axis__title" x="335" y="225">Latency (log scale)</text>
                    </g>
                </svg>
                <ul class="results-chart-legend" aria-label="DuckDB versions">
                    <li class="results-series--blue" title="DuckDB v2.0.0-alpha38615"><span></span>v2.0.0…</li>
                    <li class="results-series--green"><span></span>v1.5.5</li>
                    <li class="results-series--orange"><span></span>v1.4.4</li>
                    <li class="results-series--purple"><span></span>v1.3.2</li>
                </ul>
            </figure>
        </div>        <ol class="steps">
          <li class="step">
            <span class="step__index">01</span>
            <h3>Find relevant runs</h3>
            <p>
              Browse by benchmark or platform, then narrow the public corpus to results that match the workload and
              scale you care about.
            </p>
          </li>
          <li class="step">
            <span class="step__index">02</span>
            <h3>Compare like with like</h3>
            <p>
              Compare compatible runs, inspect query-level timings, and see where one platform gains or loses time
              instead of relying on a single headline number.
            </p>
          </li>
          <li class="step">
            <span class="step__index">03</span>
            <h3>Check your own result</h3>
            <p>
              Open a BenchBox result JSON file locally in the browser. Review its charts and run receipt without
              uploading it or adding it to the public rankings.
            </p>
            <a href="/results/local" class="step__link">Open local result file →</a>
          </li>
        </ol>
      </div>
    </section>

    <section id="benchmarks" class="section">
      <div class="container">
        <header class="section__head">
          <p class="eyebrow">Workloads</p>
          <h2>Benchmarks by Category</h2>
        </header>
        {benchmarkGroups.map((group) => <CatalogGroup group={group} />)}
      </div>
    </section>

    <section id="platforms" class="section section--band">
      <div class="container">
        <header class="section__head">
          <p class="eyebrow">Engines</p>
          <h2>Supported Platforms</h2>
        </header>
        {platformGroups.map((group) => <CatalogGroup group={group} compact />)}
      </div>
    </section>

    <section id="formats" class="section">
      <div class="container">
        <header class="section__head section__head--split">
          <div>
            <p class="eyebrow">Storage</p>
            <h2>Open Table Formats</h2>
          </div>
          <p class="section__intro">
            Convert benchmark data to modern columnar formats for optimized storage, ACID transactions, and time travel
            capabilities.
          </p>
        </header>
        {formatGroups.map((group) => <CatalogGroup group={group} compact />)}
        <div class="code-block code-block--wide">
          <div class="code-header">
            <span>Convert benchmark data to any format</span>
            <button class="copy-btn" type="button" data-target="format-code">Copy</button>
          </div>
          <CodeBlock id="format-code" lang="bash" code={formatCode} />
        </div>
      </div>
    </section>

    <section id="mcp" class="section section--band">
      <div class="container">
        <header class="section__head section__head--split">
          <div>
            <p class="eyebrow">AI agents</p>
            <h2>AI Assistant Integration</h2>
          </div>
          <p class="section__intro">
            BenchBox includes an MCP (Model Context Protocol) server for Claude Code and other AI assistants. Run
            benchmarks with natural language instead of memorizing CLI flags.
          </p>
        </header>
        <div class="mcp__setup">
          <div class="mcp__panel">
            <h3>Instruct a coding agent</h3>
            <p>
              Pick a surface, platform, benchmark, and scale. Copy the prompt into your coding agent. Defaults to a
              safe local DuckDB + TPC-H quickstart.
            </p>
            <a class="button" href="/prompts/">Open the prompt builder</a>
          </div>
          <div class="mcp__panel">
            <h3>Quick setup</h3>
            <div class="code-block">
              <div class="code-header">
                <span>Add to Claude Code</span>
                <button class="copy-btn" type="button" data-target="mcp-setup-code">Copy</button>
              </div>
              <CodeBlock id="mcp-setup-code" lang="bash" code={mcpSetupCode} />
            </div>
          </div>
        </div>
        <h3 class="subhead">What you can do</h3>
        <ul class="mcp__uses">
          {
            mcpUses.map((use) => (
              <li class="mcp__use">
                <h4>{use.title}</h4>
                {use.examples.map((example) => (
                  <p class="mcp__example">{example}</p>
                ))}
                <p>{use.body}</p>
              </li>
            ))
          }
        </ul>
        <a class="link-arrow" href="/docs/guides/mcp-integration.html">Full MCP documentation</a>
      </div>
    </section>

    <section id="install" class="section">
      <div class="container">
        <header class="section__head">
          <p class="eyebrow">Install</p>
          <h2>Get Started</h2>
        </header>
        <ol class="install">
          <li class="install__step">
            <div class="install__title"><span class="step__index">01</span><h3>Install</h3></div>
            <div class="code-block">
              <div class="code-header">
                <span>Shell</span>
                <button class="copy-btn" type="button" data-target="install-code">Copy</button>
              </div>
              <CodeBlock id="install-code" lang="bash" code={installCode} />
            </div>
          </li>
          <li class="install__step">
            <div class="install__title"><span class="step__index">02</span><h3>Run as CLI</h3></div>
            <div class="code-block">
              <CodeBlock lang="bash" code={cliExampleCode} />
            </div>
          </li>
          <li class="install__step">
            <div class="install__title"><span class="step__index">03</span><h3>Or use as a library</h3></div>
            <div class="code-block">
              <CodeBlock lang="python" code={libraryExampleCode} />
            </div>
          </li>
        </ol>
        <div class="requirements">
          <h3>Requirements</h3>
          <ul>
            <li>Python 3.11 or higher</li>
            <li>No external dependencies for data generation</li>
            <li>Optional: database drivers (duckdb, sqlite3, etc.)</li>
          </ul>
        </div>
      </div>
