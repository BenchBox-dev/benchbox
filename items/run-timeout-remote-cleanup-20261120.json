  "acceptance": [
    "On timeout, adapters that can do so cancel the statement and stop the session this run started, shown with stubbed clients.",
    "A warning tells cloud users that remote work may continue and that cleanup is not live-verified.",
    "The per-adapter capability table is in the pull request."
  ],
  "batch": {
    "batch_id": "run-timeout-core",
